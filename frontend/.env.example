# LOCAL DEVELOPMENT
# Leave blank. Vite proxies /api to http://127.0.0.1:8000.
VITE_API_BASE_URL=

# PUBLIC VERCEL FRONTEND
# In Vercel Project Settings > Environment Variables, set VITE_API_BASE_URL
# to the exact URL of the deployed Clarivo backend, without a trailing slash.
# Example: https://clarivo-api.vercel.app
