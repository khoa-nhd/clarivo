# LOCAL DEVELOPMENT
# Leave blank. Vite proxies /api to http://127.0.0.1:8000.
VITE_API_BASE_URL=

# PUBLIC VERCEL FRONTEND
# In Vercel Project Settings > Environment Variables, set VITE_API_BASE_URL
# to the exact URL of the deployed Clarivo backend, without a trailing slash.
# Example: https://clarivo-api.vercel.app

# OPTIONAL: separate backend for Voice + Visual analysis.
# Point this at a Cloudflare Tunnel to a machine running the OpenVINO stack.
# Content analysis and Q&A keep using VITE_API_BASE_URL, so the site still works
# when that machine is off - only Voice/Visual report unavailable, and they come
# back on their own once it returns.
# Leave blank to send everything to VITE_API_BASE_URL (previous behaviour).
# See DEPLOY_TUNNEL.md.
VITE_LOCAL_AI_BASE_URL=
