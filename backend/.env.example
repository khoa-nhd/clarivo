# Content evaluator. Use mock only when testing UI without AI quota.
AI_PROVIDER=mock

# Audio transcription. If blank in code it falls back to AI_PROVIDER.
# For real microphone transcription set this to cloudflare.
TRANSCRIPTION_PROVIDER=mock

# Same Cloudflare account + Workers AI token are used for Qwen and Whisper.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
CLOUDFLARE_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
CLOUDFLARE_TRANSCRIPTION_MODEL=@cf/openai/whisper-large-v3-turbo

AI_TIMEOUT_SECONDS=120
AI_MAX_TOKENS=3000
AI_TEMPERATURE=0.1
AI_MAX_ATTEMPTS=2

# Per-dimension evidence + reference comparison in the content report.
# Leave unset/true to keep them. Set to false ONLY as a kill switch: it removes
# the extra fields from the Workers AI tool schema and the prompt, degrading the
# report to the previous seven-score behaviour without a redeploy. Use it if the
# live model ever rejects the extended schema.
AI_EVIDENCE_FIELDS=true

# Identical-request cache for /api/analyze. Keyed on the full request content,
# so a hit is always the same question - editing the transcript forces a fresh
# evaluation. 0 disables it.
AI_CACHE_TTL_SECONDS=3600
AI_CACHE_MAX_ENTRIES=32
AI_RETRY_BACKOFF_SECONDS=1.0
TRANSCRIPTION_TIMEOUT_SECONDS=120

# Ceiling for the audio sent to /api/transcribe.
#
# On Vercel this must stay under the 4.5 MB Function request limit, so set it
# to 3500000 THERE. On a machine reached through a tunnel there is no platform
# limit, and the value matters: a five-minute video yields about 9.6 MB of
# 16 kHz mono WAV, so 3500000 would refuse exactly the recordings the tunnel
# exists to handle. The browser sends oversized audio to the tunnel rather than
# to Vercel, so the two values are allowed to differ.
MAX_AUDIO_BYTES=3500000

# After deploying the frontend, put its exact public URL here.
# Multiple origins can be comma-separated.
# Example: https://explain-coach.vercel.app
ALLOWED_ORIGINS=

# Origins that cannot be listed by name. Vercel gives every deployment its own
# hostname, so a preview build is refused by the browser with a CORS error that
# looks exactly like this machine being offline. Anchor the pattern to your own
# project so it does not match every Vercel site.
# Example: https://clarivo-[a-z0-9-]+\.vercel\.app
ALLOWED_ORIGIN_REGEX=

# The public site, used to build the link you hand to other people:
#     <PUBLIC_FRONTEND_URL>/?ai=<tunnel address>
# start-tunnel.bat prints that link once cloudflared has an address. Falls back
# to the first https entry in ALLOWED_ORIGINS when this is left blank.
PUBLIC_FRONTEND_URL=

# Public-demo safety guards.
MAX_RECORDING_SECONDS=300
MAX_TRANSCRIPT_CHARS=20000
MAX_REFERENCE_CHARS=20000

# Optional LOCAL Intel/OpenVINO delivery + vision analysis.
# Keep false on Vercel. Set true only when running the backend on your own laptop.
LOCAL_SCORING_ENABLED=false
LOCAL_MODELS_DIR=
LOCAL_CACHE_DIR=
LOCAL_VISION_DEVICE=RECOMMENDED
LOCAL_POSE_DEVICE=RECOMMENDED
LOCAL_SAMPLE_FPS=2.0
# Upload ceilings for local voice/visual analysis. Uploads stream to a temp
# file, so a large video costs disk rather than server memory. 1 GB comfortably
# covers a five-minute capture even at a high phone/screen-recording bitrate.
# These values are published in /api/health and the browser enforces the same
# numbers, so raising one here raises it everywhere.
LOCAL_MAX_AUDIO_WAV_BYTES=64000000
LOCAL_MAX_VIDEO_BYTES=1024000000

# Interactive Understanding Drill
DRILL_MAX_ROUNDS=3
