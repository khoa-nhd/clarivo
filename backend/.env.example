# Content evaluator. Use mock only when testing UI without AI quota.
AI_PROVIDER=mock

# Audio transcription. If blank in code it falls back to AI_PROVIDER.
# For real microphone transcription set this to cloudflare.
TRANSCRIPTION_PROVIDER=mock

# Same Cloudflare account + Workers AI token are used for Qwen and Whisper.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
CLOUDFLARE_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
CLOUDFLARE_TRANSCRIPTION_MODEL=@cf/openai/whisper-large-v3-turbo

AI_TIMEOUT_SECONDS=120
AI_MAX_TOKENS=3000
AI_TEMPERATURE=0.1
AI_MAX_ATTEMPTS=2
TRANSCRIPTION_TIMEOUT_SECONDS=120

# Keep uploads below Vercel's 4.5 MB Function request limit.
# The frontend records Opus at 48 kbps and automatically stops at 5 minutes.
MAX_AUDIO_BYTES=3500000

# After deploying the frontend, put its exact public URL here.
# Multiple origins can be comma-separated.
# Example: https://explain-coach.vercel.app
ALLOWED_ORIGINS=

# Public-demo safety guards.
MAX_RECORDING_SECONDS=300
MAX_TRANSCRIPT_CHARS=20000
MAX_REFERENCE_CHARS=20000

# Optional LOCAL Intel/OpenVINO delivery + vision analysis.
# Keep false on Vercel. Set true only when running the backend on your own laptop.
LOCAL_SCORING_ENABLED=false
LOCAL_MODELS_DIR=
LOCAL_CACHE_DIR=
LOCAL_VISION_DEVICE=RECOMMENDED
LOCAL_POSE_DEVICE=RECOMMENDED
LOCAL_SAMPLE_FPS=2.0
LOCAL_MAX_AUDIO_WAV_BYTES=16000000
LOCAL_MAX_VIDEO_BYTES=80000000

# Interactive Understanding Drill
DRILL_MAX_ROUNDS=3
